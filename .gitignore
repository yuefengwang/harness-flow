# Harness worktrees
.worktrees/

# Generated context files
workflow/current-context.md
workflow/.current-project

# IDE
.idea/

# Docker build artifacts
docker/.build-*
*.log

# Credentials (sensitive)
workflow/harness/credentials.yaml
harness/credentials.yaml
**/credentials.yaml

# A0 证据签名密钥 —— 一旦提交，任何人都能伪造 red_witness 等证据签名
config/.evidence_key
**/.evidence_key

# Tasks (temporary)
workflow/tasks/*

workspace/*

# 例外：B0 的改造前基线。它**无法重新生成**（采集依赖「A6-A9 尚未实施」
# 这个已经关闭的时间窗口），且是 A11 对照实验唯一的对照组来源。
# 被忽略等于一次 git clean 就永久丢失，因此必须入库。见 B0 第 10 节。
!workspace/probe/
!workspace/probe/**

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# macOS / IDE
.DS_Store

# Local worktrees / scratch dirs (not part of the library)
repo/
.sisyphus/
docs/history/
docs/superpowers/